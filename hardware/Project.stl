solid forest_fire_enclosure
  facet normal 0 0 -1
    outer loop
      vertex 0 0 0
      vertex 80 0 0
      vertex 80 60 0
    endloop
  endfacet
  facet normal 0 0 -1
    outer loop
      vertex 0 0 0
      vertex 80 60 0
      vertex 0 60 0
    endloop
  endfacet
  facet normal 0 0 1
    outer loop
      vertex 0 0 20
      vertex 80 60 20
      vertex 80 0 20
    endloop
  endfacet
  facet normal 0 0 1
    outer loop
      vertex 0 0 20
      vertex 0 60 20
      vertex 80 60 20
    endloop
  endfacet
endsolid forest_fire_enclosure
